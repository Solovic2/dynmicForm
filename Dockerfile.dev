FROM node:22-alpine
WORKDIR /app

# Install deps first for better layer caching (source is volume-mounted at runtime).
# prisma/ is copied before install so the postinstall `prisma generate` succeeds.
COPY package*.json ./
COPY prisma ./prisma
RUN npm install

COPY . .

ENV NODE_ENV=development
EXPOSE 8000
CMD ["npm", "run", "dev"]
