// Prisma schema for the dynmicForm backend.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  forms        Form[]

  @@map("users")
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  FILE
}

model Form {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      FormStatus   @default(DRAFT)
  // Unique public token; set when the form is first published.
  portalToken String?      @unique
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
  @@map("forms")
}

model Question {
  id         String           @id @default(uuid())
  formId     String
  form       Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  label      String
  type       QuestionType
  isRequired Boolean          @default(false)
  position   Int
  // Per-type config. TEXT: { multiline?, maxLength?, placeholder? }
  // MULTIPLE_CHOICE: { allowMultiple: boolean }
  // FILE: { acceptedMimeTypes?: string[], maxSizeBytes?: number }
  settings   Json             @default("{}")
  options    QuestionOption[]
  answers    Answer[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([formId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  position   Int
  answers    Answer[]

  @@index([questionId])
  @@map("question_options")
}

model Submission {
  id          String   @id @default(uuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())
  answers     Answer[]

  @@index([formId])
  @@map("submissions")
}

model Answer {
  id           String          @id @default(uuid())
  submissionId String
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Exactly one of the value columns is populated, depending on question type.
  // Multi-select produces one Answer row per selected option.
  textValue    String?
  optionId     String?
  option       QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  fileId       String?         @unique
  file         File?           @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([questionId])
  @@map("answers")
}

model File {
  id         String   @id @default(uuid())
  storageKey String   // S3 object key
  filename   String
  mimeType   String
  sizeBytes  Int
  answer     Answer?
  createdAt  DateTime @default(now())

  @@map("files")
}

model RefreshToken {
  id        String    @id @default(uuid())
  // SHA-256 hash of the raw refresh token — the raw value is never persisted.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
