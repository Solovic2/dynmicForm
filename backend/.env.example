# Backend environment variables
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed origins, e.g. http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by Prisma.
# For local dev with the docker-compose "db" service exposed on 5432:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dynamicform?schema=public

# JWT secrets — set to long random strings (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (jsonwebtoken/ms format).
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=7d

# S3-compatible object storage (MinIO in local dev).
# S3_ENDPOINT is what the backend uses; S3_PUBLIC_ENDPOINT is used to sign
# download URLs handed to the browser (differs under Docker: minio vs localhost).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Global upload ceiling in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
