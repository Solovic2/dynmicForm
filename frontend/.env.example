# Frontend environment variables (Vite only exposes vars prefixed with VITE_)
# Base URL used by the app when calling the API directly (optional; the app
# defaults to the /api path which is proxied by Vite in dev / nginx in prod).
VITE_API_URL=/api

# Dev-only: where Vite's /api proxy forwards to.
# Use http://localhost:3000 when running frontend on the host,
# or http://backend:3000 when running inside the dev compose network.
VITE_PROXY_TARGET=http://localhost:3000
